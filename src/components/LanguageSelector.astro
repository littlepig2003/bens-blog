<label class="language-selector"><span class="sr-only">Language</span><select aria-label="Language" data-language-selector><option value="en">English</option><option value="zh">中文</option><option value="de">Deutsch</option><option value="es">Español</option><option value="fr">Français</option></select></label>
<script>
  import { locales, normalizeLocale, t, type MessageKey } from '../lib/i18n';
  const key = 'blog-locale'; const selector = document.querySelector('[data-language-selector]') as HTMLSelectElement;
  const apply = (locale: typeof locales[number]) => { document.documentElement.lang = locale; document.documentElement.dataset.locale = locale; selector.value = locale; document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => { el.textContent = t(locale, el.dataset.i18n as MessageKey); }); };
  const current = normalizeLocale(localStorage.getItem(key) ?? navigator.languages?.find((value) => locales.includes(normalizeLocale(value))) ?? navigator.language);
  apply(current); selector?.addEventListener('change', () => { const locale = normalizeLocale(selector.value); localStorage.setItem(key, locale); apply(locale); });
</script>
