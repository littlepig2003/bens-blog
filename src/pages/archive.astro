---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isPublicPost, sortPosts } from '../lib/posts';
const posts = sortPosts((await getCollection('blog')).filter(isPublicPost));
---
<BaseLayout title="Archive · Ben's Blog" description="All posts by date."><section class="prose"><h1>Archive</h1>{posts.map((post) => <article><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.getFullYear()}</time><h2><a href={`/posts/${post.id}`}>{post.data.title}</a></h2></article>)}</section></BaseLayout>
